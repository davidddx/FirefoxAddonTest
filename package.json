{
	"name": "Better Roblox Friend Carousel",
	"version": "1.0.0",
	"type": "module",
	"scripts": {
		"clean": "rm -rf dist",
		"dev-content": "vite build -c vite.content.config.js --watch",
		"dev-popup": "vite build -c vite.popup.config.js --watch",
		"serve-popup": "vite -c vite.popup.config.js",
		"build": "vite build -c vite.content.config.js && vite build -c vite.popup.config.js"
	},
	"dependencies": {
		"react": "^19.2.4",
		"react-dom": "^19.2.4"
	},
	"devDependencies": {
		"@vitejs/plugin-react": "^4.2.0",
		"vite": "^5.0.0",
		"vite-plugin-static-copy": "^1.0.6"
	}
}
