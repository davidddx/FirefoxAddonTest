{
  "manifest_version": 3,
  "name": "Borderify",
  "version": "1.0",
  "permissions": ["storage"],
  "description": "Adds a red border to mozilla.org",
  "content_scripts": [
    {
      "matches": ["*://*.roblox.com/home"],
      "js": ["borderify.js"],
      "css": ["styles.css"]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "borderify@example.com"
    }
  }
}
